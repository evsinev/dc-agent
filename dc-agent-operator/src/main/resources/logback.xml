<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy.MM.dd HH:mm:ss.SSS} [%thread] %-5level %-20.20logger - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.github.jknack.handlebars" level="INFO" />
    <!-- GsonApiServlet logs whole request and response bodies at DEBUG: command create/update carry
         api keys and reloadHeaders tokens. Kept at INFO even when the root level is raised. -->
    <logger name="com.payneteasy.apiservlet.GsonApiServlet" level="INFO" />

    <root level="info">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
